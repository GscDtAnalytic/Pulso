# Copie para terraform.tfvars e preencha os valores reais.
# Nunca comite terraform.tfvars (está no .gitignore).

project_id       = "seu-projeto-gcp"
region           = "us-central1"
environment      = "prod"
lake_bucket_name = "pulso-lakehouse"
image_tag        = "latest"

# Chave Anthropic para o LLM explainer (Marco 7)
anthropic_api_key = "sk-ant-..."

# E-mail que recebe os alertas de SLO (Cloud Monitoring). Vazio = sem notificação.
alert_email = "voce@exemplo.com"

# Budget alert de custo mensal. Vazio = sem budget.
# Encontre o ID em: gcloud billing accounts list
billing_account = "XXXXXX-XXXXXX-XXXXXX"
budget_usd      = 60

# Kafka/Redpanda e ksqlDB são provisionados automaticamente via Compute Engine VM.
# Não é necessário configurar kafka_bootstrap ou schema_registry_url aqui.
