# Copie para .env e ajuste. Em dev, os defaults casam com o docker-compose.
# Prefixo PULSO_ (ver libs/pulso-infra/config.py).

# Kafka / Redpanda
PULSO_KAFKA_BOOTSTRAP=localhost:19092
PULSO_SCHEMA_REGISTRY_URL=http://localhost:18081

# Segurança do barramento. Dev = PLAINTEXT (docker-compose, sem TLS).
# Em prod o Terraform injeta SASL_SSL + as credenciais/CA cert via secrets:
#   PULSO_KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   PULSO_KAFKA_SASL_USERNAME=pulso
#   PULSO_KAFKA_SASL_PASSWORD=...        (secret)
#   PULSO_KAFKA_SSL_CA_PEM=-----BEGIN... (secret; ou PULSO_KAFKA_SSL_CA_LOCATION=arquivo)
PULSO_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Object storage (Iceberg). Dev = MinIO; prod (GCP) = deixe S3_ENDPOINT vazio e use GCS.
PULSO_S3_ENDPOINT=http://localhost:9000
PULSO_S3_ACCESS_KEY=minioadmin
PULSO_S3_SECRET_KEY=minioadmin
PULSO_ICEBERG_WAREHOUSE=s3://pulso-lakehouse/warehouse

# Catalogo Iceberg (sink, Marco 3). URI SQLAlchemy; dev = Postgres do compose.
PULSO_ICEBERG_CATALOG_URI=postgresql+psycopg2://pulso:pulso@localhost:5432/pulso

# Ambiente
PULSO_ENV=dev
PULSO_LOG_LEVEL=INFO
PULSO_LOG_JSON=false
